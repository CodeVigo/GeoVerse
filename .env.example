# GeoVerse environment — copy this file to ".env" and adjust as needed.
# The defaults below work for local development.

# --- Database ---
# Docker (docker compose up -d) uses user/pass/db = geoverse:
#   postgresql://geoverse:geoverse@localhost:5432/geoverse?schema=public
# A local/portable Postgres might instead be:
#   postgresql://postgres@localhost:5432/geoverse?schema=public
DATABASE_URL="postgresql://geoverse:geoverse@localhost:5432/geoverse?schema=public"

# --- Redis (reserved for future caching/jobs) ---
REDIS_URL="redis://localhost:6379"

# --- API server ---
API_PORT=4000
API_HOST="0.0.0.0"
WEB_ORIGIN="http://localhost:3000"
# Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# --- Web app ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional: free token from https://cesium.com/ion (enables 3D terrain + Bing imagery).
NEXT_PUBLIC_CESIUM_ION_TOKEN=""

# --- AI (optional, reserved) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
