{
  "name": "@geoverse/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/server.js",
    "start:prod": "tsx src/server.ts",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.1.0",
    "@geoverse/db": "workspace:*",
    "@geoverse/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.7.4",
    "dotenv-cli": "^7.4.2",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
